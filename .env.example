# Environment variables for smart-contract-revamp deployment scripts.
# Copy to .env and fill in values. See script/run-all.sh header for full documentation.
#
# For broadcast: set RPC_URL and PRIVATE_KEY.
# DeploySettlement runs only when SETTLEMENT_OWNER, SETTLEMENT_OPERATOR, CENTUARI_ADDRESS,
# and PROXY_ADMIN_OWNER are all set. UpgradeSettlement runs only when PROXY_ADMIN and
# SETTLEMENT_PROXY (or PROXY) are set, unless --deploy-only is passed.

# --- Broadcast (required for live deployment) ---
RPC_URL=
PRIVATE_KEY=

# --- DeployFaucet (optional) ---
# Backend address for Faucet operator; omit to use msg.sender
FAUCET_OPERATOR=
# Comma-separated token addresses to wire to Faucet (grant minter + addToken)
FAUCET_TOKENS=

# --- DeploySettlement (all four required to run DeploySettlement) ---
SETTLEMENT_OWNER=0x
SETTLEMENT_OPERATOR=0x
CENTUARI_ADDRESS=0x
PROXY_ADMIN_OWNER=0x

# --- UpgradeSettlement (both required to run UpgradeSettlement) ---
PROXY_ADMIN=0x
SETTLEMENT_PROXY=0x
# Or use PROXY=0x as alias for SETTLEMENT_PROXY

# --- Contract verification (optional, for forge verify-contract) ---
ETHERSCAN_API_KEY=

# Environment variables for smart-contract-revamp deployment scripts.
# Copy to .env and fill in values. See bin/run-all.sh header for full documentation.
#
# For broadcast: set RPC_URL and PRIVATE_KEY.
# Full flow (./bin/run-all.sh [--broadcast] [--deploy-only]):
#   DeployMockTokens -> DeployFaucet -> DeployBalanceLedger -> DeployCentuari
#   -> DeployBondFactory -> ConfigureBondFactory -> DeployHubDepositor
#   -> DeployCollateralStack -> ConfigureBalanceLedger -> DeploySettlement
#   -> ConfigureBalanceLedger (Settlement) -> SetSettlement -> (optional) UpgradeSettlement
#   -> SetOperators.
# Contract addresses are captured from script output when not set below.

# --- Broadcast (required for live deployment) ---
RPC_URL=
PRIVATE_KEY=

# --- Operators (required) ---
# These must be set to real addresses before running with --broadcast.
BACKEND_OPERATOR=
SETTLEMENT_OPERATOR=

# --- DeployFaucet (optional) ---
# Comma-separated token addresses to wire to Faucet (grant minter + addToken).
# When running bin/run-all.sh with DeployMockTokens, this is auto-populated
# from the deployed mock token addresses. Set manually only when wiring
# non-mock or pre-existing tokens to the Faucet.
FAUCET_TOKENS=

# --- DeployCentuari (optional) ---
# If set, skip DeployCentuari and use this for downstream steps
CENTUARI_ADDRESS=
# Centuari owner; omit to use the deployer wallet address derived from PRIVATE_KEY
CENTUARI_OWNER=
# Centuari init settlement placeholder; omit to use CENTUARI_OWNER
CENTUARI_SETTLEMENT_PLACEHOLDER=

# --- UpgradeSettlement (both required to run UpgradeSettlement) ---
# Set these if you want the final UpgradeSettlement step to run.
PROXY_ADMIN=
SETTLEMENT_PROXY=
# Or use PROXY= as alias for SETTLEMENT_PROXY

# --- Contract verification (optional, for forge verify-contract, not used by run-all.sh directly) ---
ETHERSCAN_API_KEY=

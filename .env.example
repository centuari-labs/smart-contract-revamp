# Environment variables for smart-contract-revamp deployment scripts.
# Copy to .env and fill in values. See bin/run-all.sh header for full documentation.
#
# For broadcast: set RPC_URL and PRIVATE_KEY.
# Full flow: DeployMockTokens -> DeployFaucet -> DeployTreasury -> DeployCentuari
#            -> setCentuariContract -> DeploySettlement -> UpgradeSettlement.
# Treasury and Centuari addresses are captured from script output when not set below.

# --- Broadcast (required for live deployment) ---
RPC_URL=
PRIVATE_KEY=

# --- Optional: used as FAUCET_OPERATOR and SETTLEMENT_OPERATOR when those are unset ---
OPERATOR_ADDRESS=

# --- DeployFaucet (optional) ---
# Backend address for Faucet operator; omit to use msg.sender (or OPERATOR_ADDRESS)
FAUCET_OPERATOR=
# Comma-separated token addresses to wire to Faucet (grant minter + addToken)
FAUCET_TOKENS=

# --- DeployTreasury / DeployCentuari (optional) ---
# If set, skip DeployTreasury and use this for DeployCentuari and setCentuariContract
TREASURY_ADDRESS=
# If set, skip DeployCentuari and use this for setCentuariContract and DeploySettlement
CENTUARI_ADDRESS=
# Centuari owner; omit to use SETTLEMENT_OWNER
CENTUARI_OWNER=
# Centuari init settlement placeholder; omit to use CENTUARI_OWNER
CENTUARI_SETTLEMENT_PLACEHOLDER=

# --- DeployCentuari & DeploySettlement (required for those steps) ---
SETTLEMENT_OWNER=0x
SETTLEMENT_OPERATOR=0x
PROXY_ADMIN_OWNER=0x

# --- UpgradeSettlement (both required to run UpgradeSettlement) ---
PROXY_ADMIN=0x
SETTLEMENT_PROXY=0x
# Or use PROXY=0x as alias for SETTLEMENT_PROXY

# --- Contract verification (optional, for forge verify-contract) ---
ETHERSCAN_API_KEY=
